<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.callibrity.mocapi</groupId>
        <artifactId>mocapi-examples</artifactId>
        <version>1.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>mocapi-example-tasks</artifactId>
    <name>Mocapi - Example (Tasks)</name>
    <description>Runnable streamable-http mocapi example demonstrating the MCP Tasks extension: a
        task-backed tool with progress, a task tool that elicits mid-execution, and a
        required-task tool showing the -32021 degrade</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.callibrity.mocapi</groupId>
            <artifactId>mocapi-streamable-http-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.callibrity.mocapi</groupId>
            <artifactId>mocapi-tasks</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        Native-image verification vehicle: builds this example as a GraalVM native image via
        Cloud Native Buildpacks so the MCP Tasks extension (replay ledger + tasks wire records)
        can be exercised under native reflection. See docs/design/native-image.md.

        mvn -pl examples/tasks -am -Pnative spring-boot:build-image -DBP_NATIVE_IMAGE=true
    -->
    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <configuration>
                            <image>
                                <env>
                                    <BP_NATIVE_IMAGE>true</BP_NATIVE_IMAGE>
                                </env>
                            </image>
                        </configuration>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <exclusions>
                                <exclusion>
                                    <groupId>org.springframework.boot</groupId>
                                    <artifactId>spring-boot-devtools</artifactId>
                                </exclusion>
                            </exclusions>
                        </configuration>
                        <executions>
                            <execution>
                                <id>add-reachability-metadata</id>
                                <goals>
                                    <goal>add-reachability-metadata</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Substrate-backed store swap: proves that adding mocapi-tasks-substrate + a
            Substrate Atom SPI backend to the classpath swaps InMemoryTaskStore for the
            Substrate-backed TaskStore with zero app-code changes. substrate-core alone
            gives the in-memory Atom SPI fallback (fine for this single-node example);
            the point is proving the wiring, not clustering the demo.

            mvn -pl examples/tasks -am -Psubstrate spring-boot:run
        -->
        <profile>
            <id>substrate</id>
            <dependencies>
                <dependency>
                    <groupId>com.callibrity.mocapi</groupId>
                    <artifactId>mocapi-tasks-substrate</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.jwcarman.substrate</groupId>
                    <artifactId>substrate-core</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.jwcarman.codec</groupId>
                    <artifactId>codec-jackson</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
